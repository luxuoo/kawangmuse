# ============================================
# kawangmuse 环境变量配置（BSC 专版）
# 说明：服务端只做链上只读核验，不需要钱包私钥
# ============================================

# 服务器
PORT=3000
NODE_ENV=production

# 数据库
MONGODB_URI=mongodb://localhost:27017/kawangmuse

# BSC 收款配置（只填公钥地址）
WALLET_ADDRESS=0xYourBscWalletAddress
BSC_RPC_URL=https://bsc-dataseed.binance.org
USDT_CONTRACT_ADDRESS=0x55d398326f99059f775485246999027b3197955

# ProdSeller 供应平台
PRODSELLER_API_KEY=your_prodseller_api_key

# 加价率（0.3 = 30%）
MARKUP_RATE=0.3

# 订单有效期（分钟）
ORDER_EXPIRE_MINUTES=30

# 链上确认数要求
REQUIRED_CONFIRMATIONS=15

# 日志
LOG_LEVEL=info
